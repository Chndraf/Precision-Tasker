# Ignore version control
.git
.gitignore
.gitattributes

# Ignore dependencies
/vendor
/node_modules

# Ignore build artifacts
/public/hot
/public/storage
/public/build

# Ignore environment files
.env
.env.*
!.env.example

# Ignore storage files
/storage/*.key
/storage/logs
/storage/framework/cache
/storage/framework/sessions
/storage/framework/testing
/storage/framework/views

# Ignore IDE files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Ignore test files
/tests
/phpunit.xml
/.phpunit.result.cache

# Ignore documentation
README.md
DEPLOYMENT.md
*.md

# Ignore CI/CD
.github
.gitlab-ci.yml

# Ignore development tools
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
